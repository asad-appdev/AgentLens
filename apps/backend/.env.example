# Server Network Configuration (Strict Localhost Only)
HOST=127.0.0.1
PORT=3000

# Environment
NODE_ENV=development

# WebSocket Heartbeat & Polling Interval (ms)
WS_HEARTBEAT_INTERVAL_MS=15000
CONNECTION_POLL_INTERVAL_MS=2000

# Security / Safe execution settings
ALLOW_PRIVILEGED_OPERATIONS=false
ENABLE_DRY_RUN_MODE=true
