# macOS Real-Time Network Monitor Configuration
# Strictly binds to 127.0.0.1 (Localhost Loopback Only)

HOST=127.0.0.1
PORT=43121
FRONTEND_PORT=5174
NODE_ENV=development

# WebSocket & Polling Intervals
WS_HEARTBEAT_INTERVAL_MS=15000
CONNECTION_POLL_INTERVAL_MS=2000

# Security & Dry-Run Mode (Simulation Mode)
ENABLE_DRY_RUN_MODE=true
ALLOW_PRIVILEGED_OPERATIONS=true

# Optional AI Analyst (Ollama / Local LLM)
LLM_ENABLED=false
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
